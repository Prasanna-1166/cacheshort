# Environment Configuration Example
# Copy this file to .env and configure your actual environment variables.
# NEVER commit your actual .env file or real secrets to version control.

# PostgreSQL Connection String (Supabase hosted)
# For Render deployment, use the Supabase Transaction Pooler (Port 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct connection (for local development with IPv6):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Application Environment (development, test, production)
APP_ENV=production

# Custom In-Memory LRU Cache Capacity (positive integer)
CACHE_CAPACITY=1000

# Base URL for generated short URL responses (set to your Render service URL in production)
BASE_URL=https://cacheshort.onrender.com

# Process-Local Rate Limiting Configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ENABLED=true
